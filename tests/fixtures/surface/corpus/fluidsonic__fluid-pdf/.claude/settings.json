{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
	"defaultMode": "plan",
    "allow": [],
	"ask": [],
	"deny": []
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "adb:*",
      "bq:*",
      "bundle:*",
      "coderabbit:*",
      "corepack:*",
      "cr:*",
      "docker:*",
      "emulator:*",
      "gh:*",
      "git:*",
      "maestro:*",
      "open:*",
      "pnpm:*",
      "pnpx:*",
      "railway:*",
      "turbo:*",
      "wrangler:*",
      "xcodebuild:*",
      "xcodegen:*",
      "xcrun:*",
      "./gradlew:*"
    ],
    "network": {
      "allowLocalBinding": true
    }
  }
}
