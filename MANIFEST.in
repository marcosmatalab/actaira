# What goes into the source distribution, decided here rather than left to
# setuptools' defaults. Those defaults were putting `tests/test_*.py` into the
# sdist without `conftest.py`, `tests/tsa.py` or the fixtures beside them: a
# test suite that cannot even be collected, which is worse than none.
include LICENSE
include README.md
include README.es.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include CODE_OF_CONDUCT.md
include CITATION.cff
recursive-include docs *.md

prune tests
prune .github
exclude Makefile
exclude Dockerfile
exclude .dockerignore
# `.pre-commit-hooks.yaml` and `action.yml` are integration manifests for a git
# checkout: `pre-commit` and GitHub Actions both read them out of a cloned
# repository, and neither ever looks inside a wheel. Shipping them would put two
# files in the sdist that nothing installed from it can use.
#
# The first line had been excluding a file that did not exist since phase A.1,
# which setuptools reports as a warning rather than an error and `make package`
# is not in `make all`, so nothing said so. The file exists again as of phase
# S3, so the line is true again rather than merely quiet.
exclude .pre-commit-hooks.yaml
exclude action.yml
exclude figures.json
