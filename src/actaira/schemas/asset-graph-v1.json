{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/asset-graph-v1.json",
  "title": "Asset graph",
  "description": "Assets and the declared edges between them. Every edge carries `stated_by` - the declaration or snapshot it came from - because an edge somebody declared and an edge a tool inferred are different claims, and an impact report built on the second is one nobody can check. Cycles are reported rather than defended against: sub-agents call each other, and an answer over a cyclic graph is incomplete rather than wrong.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "asset-graph/v1"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "uses",
              "runs_as",
              "reads",
              "writes",
              "exposes",
              "delegates_to",
              "uses_model",
              "governed_by",
              "evidenced_by",
              "supports",
              "served_by",
              "contains"
            ]
          },
          "to": {
            "type": "string"
          },
          "stated_by": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "relation",
          "to",
          "stated_by"
        ]
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "nodes",
    "edges",
    "cycles"
  ],
  "additionalProperties": true
}
