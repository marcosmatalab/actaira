{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/model-bundle-v2.json",
  "title": "Model bundle",
  "description": "A resolved model repository: its members, the relations its metadata declares, and the gaps between them. v2 splits the one digest v1 published into two fields that answer two different questions. `structural_digest` is over the shape - paths, sizes, roles and whatever digests were computed - and moves when a Python file appears; it is not the identity of the weights and never was. `content_identity` states, explicitly, how firmly this resolution can say which model these bytes are, because members over the hashing budget are not read and two shards with the same name and size and different bytes would otherwise have produced one value.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "model-bundle/v2"
    },
    "root": {
      "type": "string"
    },
    "structural_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "A digest over the bundle's layout. Never over its weights."
    },
    "content_identity": {
      "type": "object",
      "description": "Whether anything in this document identifies WHICH weights these are. A receipt may claim two resolutions are the same model only on `complete` or `externally_bound`, and must say whose word it is taking on the second.",
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "externally_bound",
            "unavailable"
          ]
        },
        "digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "Computable only when state is `complete`. A digest over a set that included an unidentified member would be a digest of a gap that looked exactly like a digest of the model."
        },
        "members_hashed": {
          "type": "integer",
          "minimum": 0
        },
        "members_externally_bound": {
          "type": "integer",
          "minimum": 0
        },
        "members_unidentified": {
          "type": "integer",
          "minimum": 0
        },
        "binding_source": {
          "enum": [
            "local_stream_hash",
            "connector_declared_digest",
            "mixed",
            "none"
          ]
        },
        "covers": {
          "type": "string"
        },
        "declared_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unidentified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state",
        "digest",
        "members_hashed",
        "members_unidentified",
        "binding_source"
      ],
      "additionalProperties": true
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "weights",
              "index",
              "config",
              "tokenizer",
              "code",
              "packaging",
              "other"
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Measured here, by reading the bytes. Never a value somebody else published."
          },
          "digest_not_computed": {
            "type": "string"
          },
          "declared_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "A digest whoever served this file published for it. Kept apart from `sha256` so a registry cannot decide what this tool says it verified."
          },
          "declared_by": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "size_bytes",
          "role"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "custom_code": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remote_code_entrypoints": {
      "type": "object"
    },
    "shards": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "description": "Where these bytes came from, when a connector rather than a local path produced them.",
      "properties": {
        "uri": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "connector": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ACT-[A-Z0-9]+-[0-9]+$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "rule_id",
          "severity",
          "location"
        ]
      }
    },
    "coverage": {
      "$ref": "https://actaira.dev/schemas/coverage-v1.json"
    }
  },
  "required": [
    "schema_version",
    "root",
    "structural_digest",
    "content_identity",
    "members",
    "findings",
    "coverage"
  ],
  "additionalProperties": true
}
