{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/model-bundle-v1.json",
  "title": "Model bundle",
  "description": "A resolved model repository: its members, the relations its metadata declares, and the gaps between them. `bundle_digest` is over the shape - paths, sizes, roles and whatever digests were computed - not over the weights, so it can be taken on a repository of tens of gigabytes and it moves when a Python file appears.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "model-bundle/v1"
    },
    "root": {
      "type": "string"
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "role": {
            "enum": [
              "weights",
              "index",
              "config",
              "tokenizer",
              "code",
              "packaging",
              "other"
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "digest_not_computed": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "size_bytes",
          "role"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "custom_code": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remote_code_entrypoints": {
      "type": "object"
    },
    "shards": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^ACT-[A-Z0-9]+-[0-9]+$"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "location": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          }
        },
        "required": [
          "rule_id",
          "severity",
          "location"
        ]
      }
    },
    "coverage": {
      "$ref": "https://actaira.dev/schemas/coverage-v1.json"
    }
  },
  "required": [
    "schema_version",
    "root",
    "bundle_digest",
    "members",
    "findings",
    "coverage"
  ],
  "additionalProperties": true
}
