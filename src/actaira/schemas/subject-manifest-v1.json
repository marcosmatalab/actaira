{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/subject-manifest-v1.json",
  "title": "Subject manifest",
  "description": "A list of things to decide about, when they are not all files on disk. It points at subjects and does not describe them: everything it names already has a loader, and a manifest that restated what a declaration says would be a second place for the same fact to go stale. An unknown `kind` is refused rather than skipped, because a manifest listing four subjects and governing three is the failure this document exists to prevent.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "subject-manifest/v1"
    },
    "system": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "bundle",
              "agent",
              "system",
              "source"
            ]
          },
          "path": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "connector": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "hash_weights": {
            "type": "boolean"
          },
          "facts": {
            "type": "object"
          }
        },
        "required": [
          "kind"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "subjects"
  ],
  "additionalProperties": true
}
