{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/coverage-v1.json",
  "title": "Coverage matrix",
  "description": "What a run undertook to read, surface by surface, and what it did not. A surface in state not_assessed was never in scope: it is a statement about this tool's boundaries and must not be read as a failure.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "coverage/v1"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "enum": [
              "load_time_execution",
              "archive_structure",
              "artifact_metadata",
              "raw_tensor_content",
              "behavioral_safety",
              "organizational_facts"
            ]
          },
          "state": {
            "enum": [
              "complete",
              "partial",
              "failed",
              "not_assessed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "object"
          }
        },
        "required": [
          "surface",
          "state",
          "reason"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "surfaces"
  ],
  "additionalProperties": true
}
