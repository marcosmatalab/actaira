{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actaira.dev/schemas/assurance-receipt-v2.json",
  "title": "Assurance receipt",
  "description": "A signed statement of what was observed, and - new in v2 - of what it was observed about. v1 was a document over a list of artifact reports: it could carry a policy decision and the name of a system, and it could not say what that system was made of. v2 keeps every v1 field and adds `typed_subjects`, the artifacts, bundles, agents, systems and sources the decision was actually about, each with its own provenance, plus references to the evidence, snapshots and graph behind them. Everything added is inside the signature, so editing a graph digest or an evidence reference breaks it exactly as editing a finding does. It is still not a certification and still not a score: it says what was observed, by which version, on which date, and it states what it does not cover.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "assurance-receipt/v2"
    },
    "tool": {
      "const": "actaira"
    },
    "tool_version": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "system": {
      "type": "string"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "name": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "inconclusive"
            ]
          },
          "coverage": {
            "$ref": "https://actaira.dev/schemas/coverage-v1.json"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "verdict",
          "coverage"
        ]
      }
    },
    "coverage": {
      "$ref": "https://actaira.dev/schemas/coverage-v1.json"
    },
    "findings_by_severity": {
      "type": "object",
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "supply_chain": {
      "type": "object",
      "properties": {
        "attestation": {
          "enum": [
            "none",
            "present"
          ]
        },
        "signature_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "signer_trusted": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "time_anchor_trust": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "attestation",
        "signature_verified",
        "signer_trusted"
      ]
    },
    "policy_decision": {
      "$ref": "https://actaira.dev/schemas/policy-decision-v1.json"
    },
    "states_what_it_does_not_cover": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "enum": [
              "load_time_execution",
              "archive_structure",
              "artifact_metadata",
              "raw_tensor_content",
              "behavioral_safety",
              "organizational_facts"
            ]
          },
          "state": {
            "enum": [
              "complete",
              "partial",
              "failed",
              "not_assessed"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "surface",
          "state",
          "reason"
        ]
      }
    },
    "signature": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "over": {
          "type": "string"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_id": {
          "type": "string"
        },
        "public_key_b64": {
          "type": "string"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value_b64": {
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "receipt_sha256",
        "public_key_b64",
        "fingerprint_sha256",
        "value_b64"
      ]
    },
    "typed_subjects": {
      "type": "array",
      "description": "One entry per subject the decision was about. `provenance` is per subject rather than per document because a receipt over four subjects from three sources has three provenances, and one top-level field would have to pick one.",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "bundle",
              "agent",
              "system",
              "source"
            ]
          },
          "id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "provenance": {
            "type": "object"
          },
          "content_identity": {
            "type": "object",
            "description": "Present on a bundle subject. The field that stops a receipt claiming 'the same model' about a repository whose weights nobody read.",
            "properties": {
              "state": {
                "enum": [
                  "complete",
                  "partial",
                  "externally_bound",
                  "unavailable"
                ]
              },
              "digest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "binding_source": {
                "type": "string"
              }
            },
            "required": [
              "state"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open_attack_paths": {
            "type": "integer",
            "minimum": 0
          },
          "relations": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "kind",
          "id",
          "handle"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "description": "Referenced by id and digest, never embedded: the store holds the records, and a copy inside a receipt is a second version that can disagree with the first.",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          }
        },
        "required": [
          "evidence_id"
        ]
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "snapshot_digest": {
            "type": "string"
          },
          "listing_complete": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "snapshot_digest"
        ]
      }
    },
    "graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "digest"
      ]
    },
    "trust": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "tool",
    "observed_at",
    "subjects",
    "coverage",
    "findings_by_severity",
    "supply_chain",
    "states_what_it_does_not_cover"
  ],
  "additionalProperties": true
}
